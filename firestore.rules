rules_version = '2';

// Modelo de acceso de NutriClínica
// - Hay que iniciar sesión (Firebase Auth) para tocar cualquier dato.
// - usuarios/{uid}: cada persona solo lee/escribe su propio documento, y solo puede
//   vincularse (pacienteId) a un espacio que ya exista.
// - pacientes/{codigo} y todo lo que cuelga de él (registros, menuEdiciones...):
//   lo leen/escriben las personas vinculadas a ese espacio.
// - Nutricionista: solo existe si su documento nutricionistas/{uid} fue creado desde la
//   consola de Firebase (nadie puede darse ese rol a sí mismo). Ve a los pacientes cuyo
//   espacio la eligió (pacientes/{codigo}.nutricionistaUid == su uid), puede listarlos,
//   y solo puede cambiar el estado del paciente (activo / pausado / baja), sus citas,
//   evaluaciones y notas de consulta. No puede editar comidas, perfil ni pesos.
// - Administrador: existe si su documento admins/{uid} fue creado por el servidor. Ve a todas
//   las nutricionistas y a todos los pacientes, invita nutricionistas (invitaciones/{correo}),
//   les quita el acceso y cambia la nutricionista de un paciente. No edita datos clínicos.
// - Invitación: la persona invitada, al entrar con su correo verificado, crea su propio
//   nutricionistas/{uid} con el nombre y el código que le dejó el administrador.
// - Las notificaciones y el respaldo los escribe solo el servidor (GitHub Actions con
//   cuenta de servicio, que no pasa por estas reglas).
// - Nadie puede borrar espacios desde la app.
service cloud.firestore {
  match /databases/{database}/documents {

    function iniciada() {
      return request.auth != null;
    }

    function esMiembro(codigo) {
      return iniciada()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.pacienteId == codigo;
    }

    function esAdmin() {
      return iniciada()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Correo verificado de quien hace la petición, en minúsculas (id de invitaciones/{correo}).
    function correoVerificado() {
      return iniciada()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function miCorreo() {
      return request.auth.token.email.lower();
    }

    function invitacion() {
      return get(/databases/$(database)/documents/invitaciones/$(miCorreo())).data;
    }

    function tengoInvitacion() {
      return correoVerificado()
        && exists(/databases/$(database)/documents/invitaciones/$(miCorreo()));
    }

    function esNutricionista() {
      return iniciada()
        && exists(/databases/$(database)/documents/nutricionistas/$(request.auth.uid));
    }

    // La nutricionista elegida por ese espacio.
    function esSuNutricionista(codigo) {
      return esNutricionista()
        && get(/databases/$(database)/documents/pacientes/$(codigo)).data.get('nutricionistaUid', null) == request.auth.uid;
    }

    function puedeVer(codigo) {
      return esMiembro(codigo) || esSuNutricionista(codigo);
    }

    // Campos del estado del paciente: solo los cambia la nutricionista.
    function camposEstado() {
      return ['estado', 'estadoMotivo', 'estadoDesde', 'estadoHasta'];
    }

    match /usuarios/{uid} {
      allow read: if iniciada() && request.auth.uid == uid;
      allow create, update: if iniciada() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pacienteId'])
        && request.resource.data.pacienteId is string
        && request.resource.data.pacienteId.matches('^[A-Z0-9]{4,12}$')
        && exists(/databases/$(database)/documents/pacientes/$(request.resource.data.pacienteId));
      allow delete: if false;
    }

    // Perfil de la nutricionista. Se crea desde la consola; ella solo puede ajustar
    // sus preferencias de avisos y su nombre visible.
    match /nutricionistas/{uid} {
      allow read: if (iniciada() && request.auth.uid == uid) || esAdmin();
      allow update: if iniciada() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'avisos', 'ultimoIngreso']);
      // Quien fue invitada crea su propio perfil con el nombre y código de la invitación.
      allow create: if iniciada() && request.auth.uid == uid && tengoInvitacion()
        && request.resource.data.keys().hasOnly(['nombre', 'codigo', 'correo', 'creadoEn', 'ultimoIngreso'])
        && request.resource.data.nombre == invitacion().nombre
        && request.resource.data.codigo == invitacion().codigo
        && request.resource.data.correo == miCorreo();
      // El administrador le cambia el nombre o le quita el acceso.
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre']);
      allow delete: if esAdmin();
    }

    // Administradores: los crea solo el servidor. Cada uno lee el suyo.
    match /admins/{uid} {
      allow read: if iniciada() && request.auth.uid == uid;
      allow write: if false;
    }

    // Invitaciones de nutricionista, por correo en minúsculas. Las maneja el administrador;
    // la persona invitada lee la suya y la borra al aceptarla.
    match /invitaciones/{correo} {
      allow read, delete: if esAdmin() || (correoVerificado() && miCorreo() == correo);
      allow create: if esAdmin()
        && correo == correo.lower()
        && request.resource.data.keys().hasOnly(['nombre', 'codigo', 'creadoEn'])
        && request.resource.data.nombre is string
        && request.resource.data.codigo is string
        && request.resource.data.codigo.matches('^NUT-[0-9]{4}$');
      allow update: if false;
    }

    // Código corto de cada nutricionista (p. ej. "NUT-4821") para que el paciente la elija
    // desde la app. El administrador lo reserva al invitar (uid vacío) y la invitada lo toma.
    match /codigosNutri/{codigoNutri} {
      allow get: if iniciada();
      allow list: if esAdmin();
      allow create: if esAdmin()
        && codigoNutri.matches('^NUT-[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['uid', 'correo'])
        && request.resource.data.uid == null
        && request.resource.data.correo is string;
      allow update: if tengoInvitacion()
        && resource.data.uid == null
        && resource.data.correo == miCorreo()
        && invitacion().codigo == codigoNutri
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if esAdmin();
    }

    // Estado de los procesos automáticos (respaldo, avisos, reglas). Lo escribe el servidor.
    match /sistema/{docId} {
      allow read: if esAdmin();
      allow write: if false;
    }

    match /pacientes/{codigo} {
      // Crear un espacio nuevo: el código no debe existir y debes quedar como creador.
      // Un espacio nuevo nace activo: el estado no se puede fijar al crearlo.
      allow create: if iniciada()
        && codigo.matches('^[A-Z0-9]{4,12}$')
        && request.resource.data.creadoPor == request.auth.uid
        && !request.resource.data.keys().hasAny(camposEstado());
      allow get: if puedeVer(codigo) || esAdmin();
      // El administrador ve a todos los pacientes.
      allow list: if esAdmin();
      // La nutricionista lista solo los espacios que la eligieron
      // (la consulta debe filtrar por where('nutricionistaUid', '==', uid)).
      allow list: if esNutricionista() && resource.data.get('nutricionistaUid', null) == request.auth.uid;
      // Miembros: modifican todo menos el creador y el estado. Pueden elegir o quitar a su
      // nutricionista, pero solo una que exista de verdad.
      allow update: if esMiembro(codigo)
        && request.resource.data.get('creadoPor', null) == resource.data.get('creadoPor', null)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposEstado())
        && (request.resource.data.get('nutricionistaUid', null) == null
            || request.resource.data.nutricionistaUid == resource.data.get('nutricionistaUid', null)
            || exists(/databases/$(database)/documents/nutricionistas/$(request.resource.data.nutricionistaUid)));
      // Nutricionista: solo el estado (activar, pausar o dar de baja).
      allow update: if esSuNutricionista(codigo)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposEstado())
        && request.resource.data.estado in ['activo', 'pausado', 'baja'];
      // Administrador: solo cambia la nutricionista del paciente (a una que exista, o ninguna).
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nutricionistaUid'])
        && (request.resource.data.get('nutricionistaUid', null) == null
            || exists(/databases/$(database)/documents/nutricionistas/$(request.resource.data.nutricionistaUid)));
      allow delete: if false;

      // Subcolecciones del espacio. Se listan explícitamente: en la versión 2 de las reglas
      // un comodín recursivo también coincide con el propio documento y anularía las
      // restricciones de arriba (borrado, creador).
      match /registros/{fecha}/items/{itemId} {
        allow read: if puedeVer(codigo);
        allow write: if esMiembro(codigo);
      }
      match /menuEdiciones/{dia} {
        allow read, write: if esMiembro(codigo);
      }
      match /menuHoy/{dia} {
        allow read, write: if esMiembro(codigo);
      }
      // Celulares que reciben recordatorios: cada persona registra solo el suyo.
      match /dispositivos/{uid} {
        allow read, write: if esMiembro(codigo) && request.auth.uid == uid;
      }
      // Evaluaciones de la nutricionista: el paciente las puede leer.
      match /evaluaciones/{evalId} {
        allow read: if puedeVer(codigo);
        allow write: if esSuNutricionista(codigo);
      }
      // Notas de consulta: privadas de la nutricionista.
      match /notasConsulta/{notaId} {
        allow read, write: if esSuNutricionista(codigo);
      }
    }

    // Citas: las crea y edita la nutricionista; el paciente puede verlas.
    match /citas/{citaId} {
      allow read: if iniciada() && (
        resource.data.nutricionistaUid == request.auth.uid
        || esMiembro(resource.data.pacienteId));
      allow create: if esSuNutricionista(request.resource.data.pacienteId)
        && request.resource.data.nutricionistaUid == request.auth.uid;
      allow update: if esNutricionista()
        && resource.data.nutricionistaUid == request.auth.uid
        && request.resource.data.nutricionistaUid == request.auth.uid
        && request.resource.data.pacienteId == resource.data.pacienteId;
      allow delete: if esNutricionista() && resource.data.nutricionistaUid == request.auth.uid;
    }

    // Avisos ya enviados (los escribe el servidor). Cada quien lee los suyos y
    // solo puede marcarlos como leídos.
    match /notificaciones/{notifId} {
      allow read: if iniciada() && (
        resource.data.destinoUid == request.auth.uid
        || esMiembro(resource.data.get('pacienteId', '')));
      allow update: if iniciada() && resource.data.destinoUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow create, delete: if false;
    }

    // Todo lo demás, cerrado.
    match /{otro=**} {
      allow read, write: if false;
    }
  }
}
